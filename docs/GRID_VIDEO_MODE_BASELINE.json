    "dialogue_shot_5": {
      "id": "db197365-76b7-417c-b727-940a762bc2ce",
      "index": 5,
      "duration": 17,
      "dialogues": [
        {
          "order": 1,
          "character_name": "老妇",
          "text": "你找谁？",
          "emotion_prompt": "警惕戒备"
        },
        {
          "order": 2,
          "character_name": "杜甫",
          "text": "老人家，在下是过路之人。天色已晚，想借贵处歇息一夜。不知是否方便？",
          "emotion_prompt": "疲惫而谦恭"
        },
        {
          "order": 3,
          "character_name": "老妇",
          "text": "你是从哪里来的？",
          "emotion_prompt": "谨慎盘问"
        },
        {
          "order": 4,
          "character_name": "杜甫",
          "text": "从洛阳方向来。",
          "emotion_prompt": "平静克制"
        },
        {
          "order": 5,
          "character_name": "老妇",
          "text": "那边……还在打仗吗？",
          "emotion_prompt": "忧虑迟疑"
        },
        {
          "order": 6,
          "character_name": "杜甫",
          "text": "还在打。",
          "emotion_prompt": "沉重低落"
        }
      ],
